# --- Database ---
DATABASE_URL=file:./data/cert-checker.db

# --- Auth ---
# Password for the /admin area. CHANGE THIS.
ADMIN_PASSWORD=change-me
# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-byte-random-string

# --- Public URL ---
# Encoded into the QR code and shown as the verification link. No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Origin the render worker loads the print route from. Leave unset when the
# worker runs on the same host as the app (it will use 127.0.0.1:$PORT).
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# --- GitHub OAuth (participant sign-in) ---
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:   https://<your-domain>
#   Callback URL:   https://<your-domain>/auth/github/callback
# GitHub has no API for creating OAuth Apps, so this step is manual.
# Scopes requested: read:user user:email
#
# This is NOT a token. It identifies your app, and it is what lets each
# participant prove who they are when claiming — the token in that flow is
# issued to them, in their browser, and only ever grants read:user.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub scans (the "تحديث قائمة المؤهلين" button) ---
# This one IS a token: `gh auth token`, or a fine-grained PAT with read access
# to the organisation's repositories. It is the app's own credential, used to
# read contributions and to settle who supervises each listed repo.
#
# Why a second credential? Deciding whether *someone else* supervises a repo
# needs push access to that repo. A participant's OAuth token can only ever
# report the caller's own permissions, so it cannot answer that question — and
# neither can a read-only token of your own. A token belonging to someone who
# administers the repositories can.
#
# With a token that lacks push on a listed repo, the scan still counts
# contributions correctly (public repos are readable either way) but marks every
# such person "يحتاج مراجعة" instead of approving them. The campaigns page says
# so before the scan runs, rather than returning a quietly incomplete list.
#
# Leave empty and the campaigns page still works — it just explains that the
# button is unavailable instead of returning an empty list.
GITHUB_SCAN_TOKEN=

# --- Certificate settings ---
# Prefix printed before the serial, e.g. ITQ-2026-0001
CERT_PREFIX=ITQ
# Organization name shown in the panel footer
ORG_NAME=مجتمع إتقان
# Year used as the first 4 digits of the 8-digit code
CERT_CODE_YEAR=2026

# --- Debugging ---
# Set to 1 to log every SQL statement to stdout. Noisy; leave unset in production.
# SQLITE_VERBOSE=1
