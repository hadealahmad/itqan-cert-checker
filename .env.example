# --- Database ---
DATABASE_URL=file:./data/cert-checker.db

# --- Auth ---
# Password for the /admin area. CHANGE THIS.
ADMIN_PASSWORD=change-me
# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-32-byte-random-string

# --- Public URL ---
# Encoded into the QR code and shown as the verification link. No trailing slash.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Origin the render worker loads the print route from. Leave unset when the
# worker runs on the same host as the app (it will use 127.0.0.1:$PORT).
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# --- Certificate settings ---
# Prefix printed before the serial, e.g. ITQ-2026-0001
CERT_PREFIX=ITQ
# Organization name shown in the panel footer
ORG_NAME=مجتمع إتقان
# Year used as the first 4 digits of the 8-digit code
CERT_CODE_YEAR=2026
